    color: #333333;
}

/* Estilo de los encabezados (ID, Nombre, Nueva Columna...) */
QHeaderView::section {
    background-color: #0056b3; /* Azul oscuro corporativo */
    color: #ffffff;
    padding: 8px;
    font-weight: bold;
    border: none;
    border-right: 1px solid #004085; /* Separador sutil entre columnas */
}

QHeaderView::section:last {
    border-right: none;
}

/* Estilo de las celdas individuales */
QTableWidget::item {
    padding: 6px;
}

/* Cuando el usuario selecciona una fila o celda */
QTableWidget::item:selected {
    background-color: #e7f1ff; /* Azul muy claro de fondo */
    color: #0056b3;            /* Texto en azul oscuro */
    font-weight: bold;
}</string>
