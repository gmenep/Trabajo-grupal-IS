                 </font>
                </property>
                <property name="styleSheet">
                 <string notr="true">QLineEdit {
    border: 2px solid #ced4da;
    border-radius: 6px;
    padding: 6px 12px;
    background-color: #ffffff;
    color: #333333;
    font-size: 13px;
}

/* Cuando el usuario hace clic para escribir */
QLineEdit:focus {
    border: 2px solid #0b5ed7; /* Azul a juego con tus botones */
    background-color: #ffffff;
}</string>
                </property>
