                 </size>
                </property>
                <property name="styleSheet">
                 <string notr="true">QPushButton {
    background-color: #0284c7; /* Azul moderno, menos chillón */
    color: #ffffff;
    font-size: 13px;
    font-weight: bold;
    border: none;
    border-radius: 6px; /* Bordes suavizados */
    padding: 8px 16px;
}

/* Al pasar el ratón por encima */
QPushButton:hover {
    background-color: #0369a1; /* Un azul un poco más oscuro */
}

/* Al hacer clic */
QPushButton:pressed {
    background-color: #075985; /* Más oscuro para simular hundimiento */
}</string>
                </property>
                <property name="text">
                 <string>Recargar</string>
                </property>
               </widget>
